{
  "name": "friday-web",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "preview": "vite preview",
    "gen:api": "openapi-typescript openapi.json --default-non-nullable false -o src/api/schema.ts",
    "coverage": "vitest run --coverage --coverage.provider=v8 --coverage.all --coverage.include='src/**' --coverage.exclude='src/**/*.test.*' --coverage.exclude=src/api/schema.ts --coverage.reporter=text-summary --coverage.reporter=html --coverage.reportsDirectory=coverage"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@phosphor-icons/web": "2.1.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.106.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.4",
    "three": "0.169.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.1.0",
    "happy-dom": "^21.0.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "overrides": {
      "systeminformation@<5.33.16": "5.33.16",
      "serialize-javascript@<7.1.3": "7.1.3",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "body-parser@>=2.0.0 <2.4.0": "2.4.0",
      "minimatch@>=7.0.0 <11.0.1": "11.0.1",
      "glob@>=9.0.0 <14.0.2": "14.0.2",
      "deepmerge": "file:vendor/deepmerge"
    }
  }
}
