<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Friday's server, the Python inside the app (Mac/bundle.sh), under the hardened runtime (Mac/sign.sh). The planner
     is compiled to machine code as it runs (numba, through LLVM), which writes code into memory and runs it: the
     hardened runtime forbids that unless allowed here. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key><true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
</dict>
</plist>
