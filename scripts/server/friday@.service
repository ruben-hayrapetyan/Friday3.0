# Friday on the server (HOSTED.md S1), one per copy: friday@real and friday@staging (H9, H12), as a systemd user
# service (H5) so it needs no root. Each copy's friday.env says which checkout runs (APP), which test profile it
# serves (PROFILE, H76) and on which local port (PORT); `tailscale serve` puts each on the tailnet over HTTPS.
# Installed by scripts/server/install.sh.

[Unit]
Description=Friday (%i)
After=network-online.target

[Service]
EnvironmentFile=%h/friday-hosted/%i/friday.env
Environment=FRIDAY_CONFIG=%h/friday-hosted/%i/config/friday.toml FRIDAY_CLAUDE=none
WorkingDirectory=%h/friday-hosted/%i
ExecStart=/bin/sh -c 'FRIDAY_WEB_DIST="$APP/web/dist" PYTHONPATH="$APP/src:$APP" exec "$APP/.venv/bin/python" -m friday.server.main --data-dir "%h/friday-hosted/%i/profiles/$PROFILE" demo --case "$PROFILE" --port "$PORT"'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
